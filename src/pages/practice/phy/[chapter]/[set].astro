---
import Layout from '../../../../layouts/Layout.astro';
import Navbar from '../../../../components/Navbar.astro';
import Footer from '../../../../components/Footer.astro';
import QuestionPractice from '../../../../components/QuestionPractice.astro';
import { getSetData } from '../../../../data/questions';
import { tex } from '../../../../lib/tex';
import { makeCode } from '../../../../lib/codes';

export function getStaticPaths() {
	const slugify = (s) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
	const chapters = [
		{ code: 1, name: 'Unit, Dimensions and Vector' },
		{ code: 2, name: 'Motion In A Straight Line' },
		{ code: 3, name: 'Motion In A Plane' },
		{ code: 4, name: 'Laws of Motion' },
		{ code: 5, name: 'Work, Energy and Power' },
		{ code: 6, name: 'System of Particles And Rotational Motion' },
		{ code: 7, name: 'Gravitation' },
		{ code: 8, name: 'Properties of Solids' },
		{ code: 9, name: 'Properties of Liquid' },
		{ code: 10, name: 'Thermal Properties of Matter' },
		{ code: 11, name: 'Thermodynamics' },
		{ code: 12, name: 'Kinetic Theory of Gases' },
		{ code: 13, name: 'Oscillations' },
		{ code: 14, name: 'Waves' },
		{ code: 15, name: 'Electric Charges and Fields' },
		{ code: 16, name: 'Electric Potential and Capacitance' },
		{ code: 17, name: 'Current Electricity' },
		{ code: 18, name: 'Moving Charges and Magnetism' },
		{ code: 19, name: 'Magnetism and Matter' },
		{ code: 20, name: 'Electromagnetic Induction' },
		{ code: 21, name: 'Alternating Current' },
		{ code: 22, name: 'Electromagnetic Waves' },
		{ code: 23, name: 'Ray Optics' },
		{ code: 24, name: 'Wave Optics' },
		{ code: 25, name: 'Dual Nature of Radiation and Matter' },
		{ code: 26, name: 'Atoms' },
		{ code: 27, name: 'Nuclei' },
		{ code: 28, name: 'Semiconductors' },
		{ code: 29, name: 'Electronic Devices' },
	];
	const questionSets = [
		{ id: 1, name: 'Concept Builder MCQs' },
		{ id: 2, name: 'NCERT-Essentials', badge: 'Recommended' },
		{ id: 3, name: 'Standard Question Bank', badge: 'Recommended' },
		{ id: 6, name: 'Advanced/Analytical-Type MCQs' },
		{ id: 8, name: 'Previous Year Question Bank' },
		{ id: 10, name: 'Final Revision Pack' },
	];
	const paths = [];
	for (const ch of chapters) {
		for (const st of questionSets) {
			paths.push({ params: { chapter: slugify(ch.name), set: slugify(st.name) } });
		}
	}
	return paths;
}

const { chapter, set } = Astro.params;
const slugify = (s) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');

const chapters = [
	{ code: 1, name: 'Unit, Dimensions and Vector' },
	{ code: 2, name: 'Motion In A Straight Line' },
	{ code: 3, name: 'Motion In A Plane' },
	{ code: 4, name: 'Laws of Motion' },
	{ code: 5, name: 'Work, Energy and Power' },
	{ code: 6, name: 'System of Particles And Rotational Motion' },
	{ code: 7, name: 'Gravitation' },
	{ code: 8, name: 'Properties of Solids' },
	{ code: 9, name: 'Properties of Liquid' },
	{ code: 10, name: 'Thermal Properties of Matter' },
	{ code: 11, name: 'Thermodynamics' },
	{ code: 12, name: 'Kinetic Theory of Gases' },
	{ code: 13, name: 'Oscillations' },
	{ code: 14, name: 'Waves' },
	{ code: 15, name: 'Electric Charges and Fields' },
	{ code: 16, name: 'Electric Potential and Capacitance' },
	{ code: 17, name: 'Current Electricity' },
	{ code: 18, name: 'Moving Charges and Magnetism' },
	{ code: 19, name: 'Magnetism and Matter' },
	{ code: 20, name: 'Electromagnetic Induction' },
	{ code: 21, name: 'Alternating Current' },
	{ code: 22, name: 'Electromagnetic Waves' },
	{ code: 23, name: 'Ray Optics' },
	{ code: 24, name: 'Wave Optics' },
	{ code: 25, name: 'Dual Nature of Radiation and Matter' },
	{ code: 26, name: 'Atoms' },
	{ code: 27, name: 'Nuclei' },
	{ code: 28, name: 'Semiconductors' },
	{ code: 29, name: 'Electronic Devices' },
];

const questionSets = [
	{ id: 1, name: 'Concept Builder MCQs' },
	{ id: 2, name: 'NCERT-Essentials', badge: 'Recommended' },
	{ id: 3, name: 'Standard Question Bank', badge: 'Recommended' },
	{ id: 6, name: 'Advanced/Analytical-Type MCQs' },
	{ id: 8, name: 'Previous Year Question Bank' },
	{ id: 10, name: 'Final Revision Pack' },
];

const currentChapter = chapters.find((c) => slugify(c.name) === chapter);
const currentSet = questionSets.find((s) => slugify(s.name) === set);

if (!currentChapter || !currentSet) {
	throw new Error(`Not found: ${chapter} / ${set}`);
}

const setData = currentChapter ? getSetData('P', String(currentChapter.code), String(currentSet.id)) : undefined;

function mulberry32(seed: number) {
	let s = seed >>> 0;
	return () => {
		s = (s + 0x6d2b79f5) | 0;
		let t = Math.imul(s ^ (s >>> 15), 1 | s);
		t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
		return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
	};
}

function shuffle<T>(arr: T[], seed: number): T[] {
	const a = [...arr];
	const rand = mulberry32(seed);
	for (let i = a.length - 1; i > 0; i--) {
		const j = Math.floor(rand() * (i + 1));
		[a[i], a[j]] = [a[j], a[i]];
	}
	return a;
}

const subtopics = setData
	? setData.subtopics.map((st, idx) => ({
			name: st.name,
			questions: shuffle(st.questions, currentChapter.code * 1000 + currentSet.id * 100 + idx + 7),
		}))
	: [];

const LETTER = { A: 0, B: 1, C: 2, D: 3 } as const;
let _qid = 0;
let _pcode = 0;
const subtopicsNames = subtopics.map((st) => st.name);
const mockQuestions = subtopics.flatMap((st) =>
	st.questions.map((q) => ({
		id: ++_qid,
		code: makeCode('P', _pcode++),
		ncertVerified: true,
		difficulty: 'Medium',
		accuracy: 60,
		level: 'Level 2',
		subtopic: st.name,
		pyq: false,
		question: tex(q.q),
		options: q.options.map((o) => tex(o)),
		trustedHtml: true,
		correct: LETTER[q.answer],
		image: null,
		imagePublic: q.imagePublic || null,
		imagePath: q.imagePath || null,
		solution: `Correct is Option ${q.answer} — ${st.name}`,
		hint: '',
		ncertRef: '',
	}))
);
---

{
	setData ? (
		<QuestionPractice
			chapterName={currentChapter.name}
			setName={currentSet.name}
			subjectName="Physics"
			subjectSlug="phy"
			badgeCode={currentChapter.code}
			badgeSet={currentSet.id}
			subtopics={subtopicsNames}
			questions={mockQuestions}
		/>
	) : (
		<Layout title={`${currentChapter.name} — ${currentSet.name} — NEETCore`} description={`Practice ${currentChapter.name} • ${currentSet.name} — curated NEET Physics questions.`}>
			<Navbar />
			<main class="mx-auto w-full max-w-6xl px-6 py-12 sm:py-16">
				<nav class="flex items-center gap-2 text-body-sm text-ink-muted" aria-label="Breadcrumb">
					<a href="/practice" class="hover:text-primary hover:underline">Practice</a>
					<span aria-hidden="true">/</span>
					<a href="/practice/phy" class="hover:text-primary hover:underline">Physics</a>
					<span aria-hidden="true">/</span>
					<a href={`/practice/phy/${slugify(currentChapter.name)}`} class="hover:text-primary hover:underline">{currentChapter.name}</a>
					<span aria-hidden="true">/</span>
					<span class="font-medium text-ink">{currentSet.name}</span>
				</nav>

				<a href={`/practice/phy/${slugify(currentChapter.name)}`} class="mt-6 inline-flex items-center gap-1 text-body-sm font-medium text-primary hover:underline">← Back to sets</a>

				<h1 class="mt-6 text-ink" style="font-size: clamp(1.8rem, 4vw, 2.75rem); line-height: 1.1; letter-spacing: -1px; font-weight: 700">{currentChapter.name}</h1>
				<p class="mt-3 max-w-2xl text-body-md text-ink-muted">Class {currentChapter.code <= 14 ? '11' : '12'} • Chapter {currentChapter.code} • <span class="font-medium text-ink">{currentSet.name}</span> • NEET-focused practice • NCERT-verified questions</p>

				<section class="mt-10">
					<div class="flex items-baseline justify-between gap-4">
						<h2 class="text-heading-3 text-ink">Questions</h2>
						<span class="text-eyebrow font-medium uppercase tracking-wide text-ink-faint">12 questions per set</span>
					</div>

					<div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
						<div class="group flex flex-col justify-between gap-6 rounded-xl border border-hairline bg-surface p-6 transition-all duration-200 hover:-translate-y-0.5 hover:border-primary/20 hover:shadow-[0_8px_24px_rgba(0,0,0,0.06)]">
							<div>
								<div class="flex items-start justify-between gap-3">
									<div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-primary/[0.08] text-primary ring-1 ring-primary/10 group-hover:bg-primary group-hover:text-white transition-colors">
										<svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
											<path d="M9 12h6M9 8h6M9 16h4M7 20h10a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
										</svg>
									</div>
									{currentSet.badge && (
										<span class="shrink-0 inline-flex items-center rounded-full bg-green-50 px-2.5 py-1 text-caption font-semibold tracking-wide text-green-700 ring-1 ring-green-200">{currentSet.badge}</span>
									)}
								</div>
								<h3 class="mt-4 text-body-md font-semibold leading-snug text-ink group-hover:text-primary transition-colors">{currentSet.name}</h3>
								<p class="mt-1.5 text-caption leading-relaxed text-ink-muted">NEET-focused practice • {currentChapter.name}</p>
							</div>
							<a
								href={`/practice/phy/${slugify(currentChapter.name)}/${slugify(currentSet.name)}`}
								class="inline-flex w-fit items-center gap-1.5 rounded-full bg-ink px-5 py-2.5 text-body-sm font-semibold text-white transition-all hover:bg-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
							>
								Start practice
								<svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="shrink-0 transition-transform group-hover:translate-x-0.5">
									<path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
								</svg>
							</a>
						</div>
					</div>
				</section>
			</main>
			<Footer />
		</Layout>
	)
}
