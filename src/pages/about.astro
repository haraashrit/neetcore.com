---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const values = [
	{
		title: 'Affordable for all',
		desc: 'Quality prep should never need a loan. One ₹999 pass unlocks everything — no subscriptions, no premium tier, no paywalls mid-prep.',
	},
	{
		title: 'Quality over quantity',
		desc: 'Every question is reviewed by subject experts and tagged to the exact NCERT chapter it belongs to.',
	},
	{
		title: 'Students first',
		desc: 'Built for real NEET aspirants who practice at midnight or on a bus. Available 24/7, works on any device.',
	},
];
---

<Layout title="About — NeetCore" description="NeetCore is affordable NEET question practice for every aspirant — full access for just ₹999.">
	<Navbar />
	<main>
		<!-- Page hero -->
		<section class="relative overflow-hidden" style="background-color: var(--color-secondary)">
			<div
				class="pointer-events-none absolute -left-20 top-0 h-96 w-96 rounded-full opacity-20 blur-3xl"
				style="background-color: var(--color-accent-sky)"
				aria-hidden="true"
			></div>
			<div class="relative mx-auto w-full max-w-6xl px-6 py-20 text-center sm:py-24">
				<span class="text-eyebrow font-semibold uppercase tracking-wider" style="color: var(--color-accent-sky)">About NeetCore</span>
				<h1 class="mt-4 text-white" style="font-size: clamp(2rem, 5vw, 3rem); line-height: 1.08; letter-spacing: -2px; font-weight: 700">
					Practice shouldn't cost a fortune.
				</h1>
				<p class="mx-auto mt-5 max-w-2xl text-white/85 text-body-md">
					We believe every NEET aspirant deserves access to great questions — no matter their budget, their
					internet speed, or what time of day they can study.
				</p>
			</div>
		</section>

		<!-- Mission -->
		<section class="mx-auto w-full max-w-6xl px-6 py-20">
			<div class="grid gap-12 lg:grid-cols-2 lg:items-center">
				<div>
					<span class="text-eyebrow font-semibold uppercase tracking-wider text-primary">Our mission</span>
					<h2 class="mt-3 text-ink" style="font-size: clamp(1.6rem, 3.5vw, 2.2rem); line-height: 1.12; letter-spacing: -1px; font-weight: 700">
						Level the playing field for every NEET aspirant.
					</h2>
					<p class="mt-4 text-body-md text-ink-muted">
						The NEET exam opens doors in medicine. Yet quality question banks are often locked behind expensive
						subscriptions. NeetCore removes that barrier — a complete, quality-driven question bank for Physics,
						Chemistry, Botany and Zoology, available to anyone, anywhere, at any time — for just ₹999.
					</p>
				</div>
				<div class="rounded-xl border border-hairline bg-surface p-8">
					<h3 class="text-heading-3 text-ink">What we stand for</h3>
					<ul class="mt-6 space-y-6">
						{values.map((v) => (
							<li class="flex gap-4">
								<span class="mt-2 h-2 w-2 shrink-0 rounded-full" style="background-color: var(--color-primary)"></span>
								<div>
									<h4 class="text-title text-ink">{v.title}</h4>
									<p class="mt-1 text-body-sm text-ink-muted">{v.desc}</p>
								</div>
							</li>
						))}
					</ul>
				</div>
			</div>
		</section>
	</main>
	<Footer />
</Layout>