---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Contact — NeetCore" description="Get in touch with the NeetCore team.">
	<Navbar />
	<main class="mx-auto w-full max-w-6xl px-6 py-16 sm:py-20">
		<div class="mx-auto max-w-2xl text-center">
			<span class="text-eyebrow font-semibold uppercase tracking-wider text-primary">Contact us</span>
			<h1 class="mt-3 text-ink" style="font-size: clamp(1.8rem, 4vw, 2.5rem); line-height: 1.1; letter-spacing: -1px; font-weight: 700">
				We'd love to hear from you.
			</h1>
			<p class="mt-4 text-body-md text-ink-muted">
				Whether it's a bug report, a feature request, or just saying hello — every message matters.
			</p>
		</div>

		<div class="mx-auto mt-12 max-w-[720px] rounded-2xl border border-hairline bg-white p-6 shadow-[0_4px_24px_rgba(0,0,0,0.06),0_1px_3px_rgba(0,0,0,0.04)] sm:p-8 lg:p-10">
			<form class="space-y-7" onsubmit="event.preventDefault(); alert('Message sent! (Demo) — we will wire this to hello@neetcore.com soon.');">
				<div>
					<label for="name" class="text-eyebrow font-semibold uppercase tracking-wide text-ink-secondary">Name</label>
					<input
						id="name"
						name="name"
						type="text"
						required
						placeholder="Your full name"
						autocomplete="name"
						class="mt-3 h-12 w-full rounded-lg border bg-white px-4 text-body-sm text-ink placeholder:text-ink-faint focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
						style="border-color: #dddddd"
					/>
				</div>
				<div>
					<label for="email" class="text-eyebrow font-semibold uppercase tracking-wide text-ink-secondary">Email</label>
					<input
						id="email"
						name="email"
						type="email"
						required
						placeholder="you@example.com"
						autocomplete="email"
						class="mt-3 h-12 w-full rounded-lg border bg-white px-4 text-body-sm text-ink placeholder:text-ink-faint focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
						style="border-color: #dddddd"
					/>
				</div>
				<div>
					<label for="subject" class="text-eyebrow font-semibold uppercase tracking-wide text-ink-secondary">Subject</label>
					<select
						id="subject"
						name="subject"
						required
						class="mt-3 h-12 w-full rounded-lg border bg-white px-4 text-body-sm text-ink focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
						style="border-color: #dddddd"
					>
						<option value="">Choose a topic</option>
						<option value="bug">Bug report</option>
						<option value="feature">Feature request</option>
						<option value="content">Content correction</option>
						<option value="general">General question</option>
						<option value="other">Other</option>
					</select>
				</div>
				<div>
					<label for="message" class="text-eyebrow font-semibold uppercase tracking-wide text-ink-secondary">Message</label>
					<textarea
						id="message"
						name="message"
						rows="7"
						required
						placeholder="Tell us what's on your mind..."
						class="mt-3 min-h-[180px] w-full rounded-lg border bg-white px-4 py-4 text-body-sm leading-relaxed text-ink placeholder:text-ink-faint focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 resize-y"
						style="border-color: #dddddd"
					></textarea>
					<p class="mt-2 text-caption text-ink-faint">We usually reply within 24 hours.</p>
				</div>
				<button
					type="submit"
					class="h-12 w-full rounded-full px-8 text-body-md font-semibold text-white transition-all duration-200 hover:opacity-90 active:scale-[0.98] sm:w-auto"
					style="background-color: var(--color-primary)"
				>
					Send message
				</button>
			</form>

			<div class="mt-10 border-t border-hairline pt-8 text-center">
				<p class="text-body-sm text-ink-muted">Or email us directly at</p>
				<p class="mt-1 text-body-md font-medium text-ink"><a href="mailto:hello@neetcore.com" class="text-primary hover:underline">hello@neetcore.com</a></p>
			</div>
		</div>
	</main>
	<Footer />
</Layout>
