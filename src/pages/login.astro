---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import BrandLogo from '../components/BrandLogo.astro';

const benefits = [
	'Pick up exactly where you left off',
	'Progress and bookmarks synced across devices',
	'Your revision queue stays up to date',
];
---

<Layout title="Log in — NEETCore" description="Log in to your NEETCore account and continue practicing.">
	<section class="band-texture relative flex min-h-[92vh] items-center overflow-hidden" style="background-color: var(--color-secondary)">
		<div
			class="pointer-events-none absolute -left-20 top-10 h-96 w-96 rounded-full opacity-20 blur-3xl"
			style="background-color: var(--color-accent-sky)"
			aria-hidden="true"
		></div>
		<div
			class="pointer-events-none absolute -right-16 bottom-0 h-80 w-80 rounded-full opacity-15 blur-3xl"
			style="background-color: var(--color-accent-purple)"
			aria-hidden="true"
		></div>

		<div class="relative mx-auto grid w-full max-w-6xl items-center gap-10 px-4 py-12 sm:px-6 sm:py-16 lg:grid-cols-2 lg:gap-12 xl:gap-16">
			<!-- Left: value pitch -->
			<div class="hidden text-white lg:block">
				<span class="inline-flex items-center gap-2 rounded-full border border-white/10 px-4 py-1.5 text-eyebrow font-semibold" style="background-color: rgba(255,255,255,0.07); color: var(--color-accent-sky)">
					Welcome back
				</span>
				<h1 class="mt-6 max-w-md" style="font-family: 'Grift', sans-serif; font-size: clamp(2rem, 4vw, 2.75rem); line-height: 1.06; letter-spacing: -1.5px; font-weight: 800; text-wrap: balance;">
					Every question you answered made you better.
				</h1>
				<p class="mt-4 max-w-md text-body-md leading-relaxed text-white/80">
					Log in to keep your streak alive and pick up exactly where you left off.
				</p>
				<ul class="mt-8 space-y-4">
					{benefits.map((b) => (
						<li class="flex items-start gap-3 text-body-sm text-white/85">
							<svg class="mt-0.5 shrink-0" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
								<circle cx="12" cy="12" r="10" stroke="var(--color-accent-green)" stroke-width="2" />
								<path d="M8.5 12.5l2.5 2.5 4.5-5.5" stroke="var(--color-accent-green)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
							<span>{b}</span>
						</li>
					))}
				</ul>
			</div>

			<!-- Right: login card -->
			<div class="w-full max-w-[440px] justify-self-center rounded-xl border border-hairline bg-canvas p-6 shadow-pop sm:p-8 lg:justify-self-end">
				<a href="/" class="flex items-center gap-2 text-ink" aria-label="NEETCore home">
					<BrandLogo class="h-4 w-auto" />
				</a>
				<h1 class="mt-6 text-heading-2 text-ink">Welcome back</h1>
				<p class="mt-2 text-body-sm text-ink-muted">Log in to continue your practice.</p>

				<form class="mt-8 space-y-6" onsubmit="event.preventDefault(); alert('Login is coming soon — backend not connected yet.');">
					<div>
						<label for="email" class="text-eyebrow font-semibold uppercase tracking-wider text-ink-secondary">Email</label>
						<input
							id="email"
							name="email"
							type="email"
							autocomplete="email"
							required
							placeholder="you@example.com"
							class="field-input mt-2.5"
						/>
					</div>
					<div>
						<div class="flex items-center justify-between">
							<label for="password" class="text-eyebrow font-semibold uppercase tracking-wider text-ink-secondary">Password</label>
							<a href="/forgot-password" class="text-caption font-medium text-primary hover:underline">Forgot password?</a>
						</div>
						<input
							id="password"
							name="password"
							type="password"
							autocomplete="current-password"
							required
							placeholder="Your password"
							class="field-input mt-2.5"
						/>
					</div>
					<button
						type="submit"
						class="mt-1 h-11 w-full rounded-full text-body-md font-semibold text-white shadow-lift transition-all duration-200 hover:opacity-95 active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
						style="background-color: var(--color-primary)"
					>
						Log in
					</button>
				</form>

				<p class="mt-6 text-center text-body-sm text-ink-muted">
					New to NEETCore?
					<a href="/signup" class="font-medium text-primary hover:underline">Create your account</a>
				</p>
			</div>
		</div>
	</section>
	<Footer />
</Layout>
