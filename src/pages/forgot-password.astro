---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Forgot password — NeetCore" description="Reset your NeetCore password.">
	<section class="band-texture relative flex min-h-[90vh] items-center overflow-hidden" style="background-color: var(--color-secondary)">
		<div class="pointer-events-none absolute -left-20 top-10 h-96 w-96 rounded-full opacity-20 blur-3xl" style="background-color: var(--color-accent-sky)" aria-hidden="true"></div>
		<div class="relative mx-auto w-full max-w-[440px] px-4 py-10 sm:px-6 sm:py-16">
			<div class="w-full rounded-xl border border-hairline bg-canvas p-6 shadow-pop sm:p-8">
				<a href="/login" class="text-caption font-medium text-primary hover:underline">← Back to log in</a>
				<h1 class="mt-4 text-heading-2 text-ink">Reset password</h1>
				<p class="mt-2 text-body-sm text-ink-muted">Enter your email and we'll send reset instructions.</p>
				<form class="mt-8 space-y-6" onsubmit="event.preventDefault(); alert('Password reset is coming soon. Please contact hello@neetcore.com for help.');">
					<div>
						<label for="email" class="text-eyebrow font-semibold uppercase tracking-wider text-ink-secondary">Email</label>
						<input id="email" name="email" type="email" autocomplete="email" required placeholder="you@example.com" class="field-input mt-2.5" />
					</div>
					<button type="submit" class="mt-1 h-11 w-full rounded-full text-body-md font-semibold text-white transition-all duration-200 hover:opacity-90 active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2" style="background-color: var(--color-primary)">Send reset link</button>
				</form>
			</div>
		</div>
	</section>
	<Footer />
</Layout>
