---
import BrandLogo from './BrandLogo.astro';
/**
 * Site footer — warm canvas-soft band, multi-column link directory.
 */
const columns = [
	{
		heading: 'Practice',
		links: [
			{ label: 'Physics questions', href: '/#subjects' },
			{ label: 'Chemistry questions', href: '/#subjects' },
			{ label: 'Biology questions', href: '/#subjects' },
			{ label: 'Chapter-wise practice', href: '/practice' },
			{ label: 'Daily practice sets', href: '/#practice' },
		],
	},
	{
		heading: 'Company',
		links: [
			{ label: 'About NEETCore', href: '/about' },
			{ label: 'Resources', href: '/resources' },
			{ label: 'Open source', href: 'https://github.com', external: true },
			{ label: 'Contact', href: '/contact' },
		],
	},
	{
		heading: 'Legal',
		links: [
			{ label: 'Privacy policy', href: '/privacy' },
			{ label: 'Terms of service', href: '/terms' },
		],
	},
];
---

<footer class="border-t border-hairline bg-canvas-soft py-16">
	<div class="mx-auto grid w-full max-w-6xl gap-10 px-6 sm:gap-12 md:grid-cols-2 lg:grid-cols-[1.7fr_1fr_1fr_1fr]">
		<!-- Brand column -->
		<div class="lg:pr-8">
			<a href="/" class="flex items-center gap-2 text-ink" aria-label="NEETCore home">
				<BrandLogo class="h-10 w-auto" />
			</a>
			<p class="mt-4 max-w-prose text-caption leading-relaxed text-ink-muted text-pretty">
				Full NEET prep for just ₹999, available 24/7.<br class="hidden sm:inline" />
				Quality-driven questions in Physics, Chemistry, Botany and Zoology — one small price, zero paywalls.
			</p>
			<div class="mt-6 flex items-center gap-2">
				<a
					href="https://github.com"
					target="_blank"
					rel="noopener noreferrer"
					aria-label="NEETCore on GitHub"
					class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-hairline bg-surface text-ink-muted transition-colors hover:border-ink-faint hover:text-ink"
				>
					<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.75 2.69 1.25 3.34.95.1-.74.4-1.25.72-1.53-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.67.41.35.77 1.05.77 2.12 0 1.53-.01 2.76-.01 3.14 0 .3.2.67.8.55A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z" />
					</svg>
				</a>
				<a
					href="https://x.com"
					target="_blank"
					rel="noopener noreferrer"
					aria-label="NEETCore on X"
					class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-hairline bg-surface text-ink-muted transition-colors hover:border-ink-faint hover:text-ink"
				>
					<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path d="M18.9 1.15h3.68l-8.04 9.19L24 22.85h-7.41l-5.8-7.58-6.64 7.58H.47l8.6-9.83L0 1.15h7.59l5.24 6.93 6.07-6.93Zm-1.29 19.5h2.04L6.49 3.24H4.3l13.31 17.41Z" />
					</svg>
				</a>
				<a
					href="/contact"
					aria-label="Contact NEETCore"
					class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-hairline bg-surface text-ink-muted transition-colors hover:border-ink-faint hover:text-ink"
				>
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
						<rect x="3" y="5" width="18" height="14" rx="2" />
						<path d="M3 7l9 6 9-6" stroke-linecap="round" stroke-linejoin="round" />
					</svg>
				</a>
			</div>
		</div>

		<!-- Link columns -->
		{columns.map((col) => (
			<div>
				<h3 class="text-eyebrow font-semibold uppercase tracking-wider text-ink-secondary">{col.heading}</h3>
				<ul class="mt-4 space-y-3">
					{col.links.map((link) => (
						<li>
							<a
								href={link.href}
								target={link.external ? '_blank' : undefined}
								rel={link.external ? 'noopener noreferrer' : undefined}
								class="text-caption text-ink-muted transition-colors hover:text-primary focus-visible:text-primary"
							>
								{link.label}
							</a>
						</li>
					))}
				</ul>
			</div>
		))}
	</div>

	<div class="mx-auto mt-12 flex w-full max-w-6xl flex-col gap-2 border-t border-hairline px-6 pt-8 sm:flex-row sm:items-center sm:justify-between">
		<p class="text-caption text-ink-faint">© {new Date().getFullYear()} NEETCore. All rights reserved.</p>
		<p class="text-caption text-ink-faint">Carefully curated by SIRIXLabs Pvt. Ltd.</p>
		<p class="text-caption text-ink-faint">Made for NEET aspirants, with care.</p>
	</div>
</footer>