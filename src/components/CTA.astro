---
/**
 * Final CTA — full-bleed dark indigo band that bookends the hero.
 */
---

<section class="band-texture relative overflow-hidden" style="background-color: var(--color-secondary)">
	<div
		class="pointer-events-none absolute -top-32 left-1/2 h-[26rem] w-[42rem] -translate-x-1/2 rounded-full opacity-25 blur-3xl animate-drift"
		style="background: radial-gradient(closest-side, rgba(98, 174, 240, 0.5), transparent)"
		aria-hidden="true"
	></div>
	<div
		class="pointer-events-none absolute -bottom-24 -right-16 h-80 w-80 rounded-full opacity-20 blur-3xl animate-drift-soft"
		style="background-color: var(--color-accent-purple)"
		aria-hidden="true"
	></div>

	<div class="reveal relative mx-auto w-full max-w-6xl px-6 py-24 text-center sm:py-28">
		<div class="flex flex-wrap items-center justify-center gap-2" aria-label="Highlights">
			<span class="rounded-full border border-white/15 bg-white/5 px-3.5 py-1.5 text-[12px] font-semibold text-white/80">80K+ questions</span>
			<span class="rounded-full border border-white/15 bg-white/5 px-3.5 py-1.5 text-[12px] font-semibold text-white/80">All 4 subjects</span>
			<span class="rounded-full border border-white/15 bg-white/5 px-3.5 py-1.5 text-[12px] font-semibold text-white/80">24/7 access</span>
			<span class="rounded-full border border-white/15 bg-white/5 px-3.5 py-1.5 text-[12px] font-semibold text-white/80">Just ₹999</span>
		</div>
		<h2 class="mx-auto mt-6 max-w-2xl text-white" style="font-family: 'Grift', sans-serif; font-size: clamp(2rem, 4.5vw, 3rem); line-height: 1.06; letter-spacing: -1.5px; font-weight: 800; text-wrap: balance;">
			Ready to start practicing?
		</h2>
		<p class="mx-auto mt-5 max-w-xl text-body-md leading-relaxed text-white/80 text-pretty">
			Join thousands of NEET aspirants already using NEETCore. One small payment of ₹999 unlocks
			everything — no subscription, no hidden charges.
		</p>
		<div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
			<a
				href="/signup"
				class="inline-flex items-center justify-center gap-2 rounded-full bg-white px-8 py-4 text-body-md font-semibold shadow-lift transition-all duration-200 hover:-translate-y-0.5 active:scale-[0.98]"
				style="color: var(--color-secondary)"
			>
				Get full access — ₹999
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
					<path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
				</svg>
			</a>
			<a
				href="/#subjects"
				class="inline-flex items-center justify-center rounded-full border border-white/20 bg-white/5 px-8 py-4 text-body-md font-medium text-white transition-all duration-200 hover:border-white/35 hover:bg-white/10"
			>
				Explore subjects first
			</a>
		</div>
		<p class="mt-8 text-caption text-white/55">
			One-time ₹999 · No subscription · No hidden charges.
		</p>
	</div>
</section>
