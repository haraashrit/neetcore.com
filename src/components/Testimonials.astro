---
/**
 * Testimonials — aspirant stories. Initial-avatars (no photos), star
 * ratings, first name + last initial. No ranks, no fabricated scores.
 */
const stories = [
	{
		quote:
			'The daily DPPs fixed my revision. I open the site every morning and a fresh set is waiting — all for less than my monthly bus fare.',
		name: 'Ananya S.',
		meta: 'Class 12',
		initial: 'A',
		bg: 'linear-gradient(135deg, #0075de, #62aef0)',
	},
	{
		quote:
			'CBT mocks feel exactly like the real interface. My silly mistakes dropped within a month because I could drill them the same day.',
		name: 'Rohan M.',
		meta: 'Dropper',
		initial: 'R',
		bg: 'linear-gradient(135deg, #5b3df5, #a78bfa)',
	},
	{
		quote:
			'Flashcards got me through Genetics. Eight minutes on the bus, one chapter revised. The whole thing costs less than a pizza — I keep waiting for the catch.',
		name: 'Priya K.',
		meta: 'Class 11',
		initial: 'P',
		bg: 'linear-gradient(135deg, #0e9f6e, #6ee7a8)',
	},
];
---

<section id="stories" class="border-y border-hairline bg-canvas">
	<div class="mx-auto w-full max-w-6xl px-6 py-24 sm:py-28">
		<div class="reveal mx-auto max-w-3xl text-center">
			<span class="text-eyebrow font-semibold uppercase tracking-wider text-primary">Aspirant stories</span>
			<h2 class="mt-3 text-ink" style="font-size: clamp(1.8rem, 4vw, 2.5rem); line-height: 1.1; letter-spacing: -1px; font-weight: 700; text-wrap: balance;">
				Loved by the people grinding every day.
			</h2>
			<div class="mt-4 flex items-center justify-center gap-1.5" aria-label="Rated 4.9 out of 5 by aspirants">
				{[...Array(5)].map(() => (
					<svg width="16" height="16" viewBox="0 0 24 24" fill="#f59e0b" aria-hidden="true">
						<path d="M12 2l2.9 6.26 6.86.84-5.08 4.68 1.3 6.77L12 17.5l-5.98 3.05 1.3-6.77L2.24 9.1l6.86-.84L12 2z" />
					</svg>
				))}
				<span class="ml-1 text-caption font-semibold text-ink-muted">4.9/5 aspirant rating</span>
			</div>
		</div>

		<div class="mt-12 grid gap-5 md:grid-cols-3">
			{stories.map((s, i) => (
				<figure
					class={`reveal reveal-d${i} flex flex-col rounded-xl border border-hairline bg-surface p-6 shadow-card transition-all duration-200 hover:-translate-y-1 hover:shadow-lift`}
				>
					<div class="flex items-center gap-1" aria-label="5 out of 5 stars">
						{[...Array(5)].map(() => (
							<svg width="14" height="14" viewBox="0 0 24 24" fill="#f59e0b" aria-hidden="true">
								<path d="M12 2l2.9 6.26 6.86.84-5.08 4.68 1.3 6.77L12 17.5l-5.98 3.05 1.3-6.77L2.24 9.1l6.86-.84L12 2z" />
							</svg>
						))}
					</div>
					<blockquote class="mt-4 flex-1 text-body-sm leading-relaxed text-ink-secondary">
						“{s.quote}”
					</blockquote>
					<figcaption class="mt-6 flex items-center gap-3 border-t border-hairline pt-5">
						<span
							class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full text-[15px] font-bold text-white"
							style={`background: ${s.bg}`}
							aria-hidden="true"
						>
							{s.initial}
						</span>
						<span>
							<span class="block text-body-sm font-bold text-ink">{s.name}</span>
							<span class="block text-caption text-ink-muted">{s.meta}</span>
						</span>
					</figcaption>
				</figure>
			))}
		</div>
	</div>
</section>
