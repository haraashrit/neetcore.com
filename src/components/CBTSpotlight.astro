---
/**
 * CBTSpotlight — dark band selling the exam-day simulation.
 * Copy + checklist on the left, live practice UI preview on the right.
 */
import PracticePreview from './PracticePreview.astro';

const points = [
	{
		title: 'NTA-identical layout',
		desc: 'Palette, question controls and navigation arranged exactly like the real exam screen.',
	},
	{
		title: 'Real exam timing',
		desc: 'Per-subject timer plus total countdown, so pacing becomes second nature.',
	},
	{
		title: 'Review like a topper',
		desc: 'Mark for review, clear responses and jump across sections without losing your place.',
	},
	{
		title: 'Instant scorecard',
		desc: 'Accuracy, weak chapters and projected score the moment you submit every mock.',
	},
];
---

<section id="cbt" class="band-texture relative overflow-hidden" style="background-color: var(--color-secondary)">
	<div
		class="pointer-events-none absolute -top-32 right-1/4 h-[24rem] w-[36rem] rounded-full opacity-20 blur-3xl animate-drift"
		style="background: radial-gradient(closest-side, rgba(98, 174, 240, 0.5), transparent)"
		aria-hidden="true"
	></div>

	<div class="relative mx-auto grid w-full max-w-6xl items-center gap-12 px-6 py-24 sm:py-28 lg:grid-cols-[1fr_1.15fr]">
		<div class="reveal">
			<span class="text-eyebrow font-semibold uppercase tracking-wider" style="color: var(--color-accent-sky)">CBT Mode</span>
			<h2 class="mt-3 text-white" style="font-size: clamp(1.8rem, 4vw, 2.5rem); line-height: 1.1; letter-spacing: -1px; font-weight: 700; text-wrap: balance;">
				Exam day feels like just another session.
			</h2>
			<p class="mt-4 text-body-md leading-relaxed text-white/75">
				Same interface. Same timer. Same pressure. Walk into the hall having already sat the exam a
				hundred times — for less than the cost of a pizza.
			</p>
			<ul class="mt-8 space-y-5">
				{points.map((p) => (
					<li class="flex gap-3.5">
						<span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-white/10" aria-hidden="true">
							<svg width="13" height="13" viewBox="0 0 24 24" fill="none">
								<path d="M5 12.5l4.5 4.5L19 7.5" stroke="#7ab8f5" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</span>
						<span>
							<span class="block text-body-sm font-bold text-white">{p.title}</span>
							<span class="mt-0.5 block text-body-sm leading-relaxed text-white/65">{p.desc}</span>
						</span>
					</li>
				))}
			</ul>
			<div class="mt-9 flex flex-col gap-3 sm:flex-row">
				<a
					href="/practice"
					class="btn-shine inline-flex items-center justify-center gap-2 rounded-full px-7 py-3.5 text-body-sm font-semibold text-white shadow-lift transition-all duration-200 hover:-translate-y-0.5 hover:opacity-95 active:scale-[0.98]"
					style="background-color: var(--color-primary)"
				>
					Get full access — ₹999
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
						<path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
					</svg>
				</a>
				<a
					href="/#practice"
					class="inline-flex items-center justify-center rounded-full border border-white/20 bg-white/5 px-7 py-3.5 text-body-sm font-medium text-white transition-all duration-200 hover:border-white/35 hover:bg-white/10"
				>
					All practice modes
				</a>
			</div>
		</div>

		<div class="reveal reveal-d1">
			<PracticePreview />
		</div>
	</div>
</section>
