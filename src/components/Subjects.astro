---
/**
 * Subjects — 4 subject cards (Physics, Chemistry, Botany, Zoology).
 * Each card: tinted icon tile (sticker palette) over a white body,
 * with topic list and a hover-revealed action row.
 */
const subjects = [
	{
		name: 'Physics',
		chapters: '29 chapters',
		topics: ['Mechanics', 'Optics', 'Modern Physics', 'Electromagnetism'],
		accent: 'var(--color-accent-sky)',
		icon: 'atom',
	},
	{
		name: 'Chemistry',
		chapters: '20 chapters',
		topics: ['Physical', 'Organic', 'Inorganic'],
		accent: 'var(--color-accent-orange)',
		icon: 'flask',
	},
	{
		name: 'Botany',
		chapters: '22 chapters',
		topics: ['Plant Kingdom', 'Genetics', 'Ecology'],
		accent: 'var(--color-accent-green)',
		icon: 'leaf',
	},
	{
		name: 'Zoology',
		chapters: '16 chapters',
		topics: ['Human Physiology', 'Reproduction', 'Evolution'],
		accent: 'var(--color-accent-purple)',
		icon: 'dna',
	},
];
---

<section id="subjects" class="mx-auto w-full max-w-6xl px-6 py-24 sm:py-28">
	<div class="reveal max-w-3xl">
		<span class="text-eyebrow font-semibold uppercase tracking-wider text-primary">Your subjects</span>
		<h2 class="mt-3 text-ink" style="font-size: clamp(1.8rem, 4vw, 2.5rem); line-height: 1.1; letter-spacing: -1px; font-weight: 700; text-wrap: balance;">
			Every subject. Every chapter. All in one place.
		</h2>
		<p class="mt-4 text-body-md text-ink-muted">
			Work through the full NEET syllabus, chapter by chapter. Track what you've covered and where you
			need the most attention.
		</p>
	</div>

	<div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
		{subjects.map((s, i) => (
			<a
				href="/practice"
				class={`reveal reveal-d${i} group relative flex flex-col overflow-hidden rounded-xl border border-hairline bg-surface p-6 pt-7 shadow-card transition-all duration-200 hover:-translate-y-1 hover:shadow-lift`}
				style={`--card-accent: ${s.accent}`}
			>
				<!-- Top accent bar -->
				<span
					class="absolute inset-x-0 top-0 h-1 origin-left scale-x-0 transition-transform duration-300 group-hover:scale-x-100"
					style={`background: linear-gradient(to right, ${s.accent}, transparent)`}
					aria-hidden="true"
				></span>
				<div class="flex items-start justify-between gap-3">
					<div
						class="flex h-12 w-12 items-center justify-center rounded-lg transition-transform duration-300 group-hover:scale-105"
						style={`background-color: color-mix(in srgb, ${s.accent} 14%, transparent); color: ${s.accent}`}
						aria-hidden="true"
					>
					{s.icon === 'atom' && (
						<svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
							<circle cx="12" cy="12" r="1.6" fill="currentColor" stroke="none" />
							<ellipse cx="12" cy="12" rx="9.5" ry="3.8" />
							<ellipse cx="12" cy="12" rx="9.5" ry="3.8" transform="rotate(60 12 12)" />
							<ellipse cx="12" cy="12" rx="9.5" ry="3.8" transform="rotate(120 12 12)" />
						</svg>
					)}
					{s.icon === 'flask' && (
						<svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
							<path d="M10 3h4M10 3v6.3L4.8 17a2.4 2.4 0 0 0 2.1 3.6h10.2a2.4 2.4 0 0 0 2.1-3.6L14 9.3V3" />
							<path d="M7.5 14h9" />
						</svg>
					)}
					{s.icon === 'leaf' && (
						<svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
							<path d="M4 20c0-9 5-15 16-16 0 11-6 15-13 15" />
							<path d="M4 20c3-6 7-9 12-11" />
						</svg>
					)}
					{s.icon === 'dna' && (
						<svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
							<path d="M5 3c0 6 14 6 14 12M19 3c0 6-14 6-14 12M5 21c0-2 14-2 14 0" />
							<path d="M8 7h8M8 17h8M10 11h4M10 21h4M10 3h4" />
						</svg>
					)}
					</div>
					<span
						class="rounded-full px-2.5 py-1 text-[11px] font-semibold leading-none"
						style={`background-color: color-mix(in srgb, ${s.accent} 12%, transparent); color: ${s.accent}`}
					>
						{s.chapters}
					</span>
				</div>

				<h3 class="mt-5 text-heading-3 text-ink">{s.name}</h3>

				<ul class="mt-4 flex flex-wrap gap-1.5">
					{s.topics.map((t) => (
						<li class="rounded-full border border-hairline bg-canvas-soft px-2.5 py-1 text-[11px] font-medium leading-none text-ink-muted">
							{t}
						</li>
					))}
				</ul>

				<span class="mt-auto block pt-5">
					<span class="flex items-center gap-1.5 border-t border-hairline pt-4 text-body-sm font-semibold text-primary transition-all duration-200 group-hover:gap-2.5">
						Browse questions
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="transition-transform duration-200 group-hover:translate-x-0.5" aria-hidden="true">
							<path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
					</span>
				</span>
			</a>
		))}
	</div>
</section>
