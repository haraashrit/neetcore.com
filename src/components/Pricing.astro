---
/**
 * Pricing — the differentiator. Premium prep at a pocket-money price:
 * ₹999 one-time vs typical paid platforms. Competitors never named.
 */
const rows = [
	{ label: 'Price', us: '₹999 — one-time', them: '₹4,000–₹12,000 / year', hot: true },
	{ label: 'Full question bank', us: 'check', them: 'check' },
	{ label: 'Real CBT mocks + analytics', us: 'check', them: 'check' },
	{ label: 'Custom tests, DPPs, flashcards', us: 'check', them: 'check' },
	{ label: 'Subscriptions & renewals', us: 'none', them: 'Every year' },
	{ label: 'Locked chapters & daily caps', us: 'none', them: 'After trial ends' },
];
---

<section id="pricing" class="mx-auto w-full max-w-6xl px-6 py-24 sm:py-28">
	<div class="reveal mx-auto max-w-3xl text-center">
		<span class="text-eyebrow font-semibold uppercase tracking-wider text-primary">One small price</span>
		<h2 class="mt-3 text-ink" style="font-size: clamp(1.8rem, 4vw, 2.5rem); line-height: 1.1; letter-spacing: -1px; font-weight: 700; text-wrap: balance;">
			Premium prep. Pocket-money price.
		</h2>
		<p class="mt-4 text-body-md text-ink-muted">
			One payment of ₹999 unlocks the entire toolkit — the same quality others sell for thousands,
			at a price every aspirant can afford.
		</p>
	</div>

	<div class="reveal mx-auto mt-12 max-w-3xl overflow-hidden rounded-2xl border border-hairline bg-surface shadow-pop">
		<!-- Header row -->
		<div class="grid grid-cols-[1.2fr_1fr_1fr] items-center gap-2 border-b border-hairline bg-canvas-soft px-5 py-4 sm:px-7">
			<span class="text-eyebrow font-semibold uppercase tracking-wider text-ink-faint">Compare</span>
			<span class="text-center text-body-sm font-bold text-primary">NEETCore</span>
			<span class="text-center text-caption font-medium text-ink-faint">Typical paid platforms</span>
		</div>
		{rows.map((r, i) => (
			<div class={`grid grid-cols-[1.2fr_1fr_1fr] items-center gap-2 px-5 py-4 sm:px-7 ${i < rows.length - 1 ? 'border-b border-hairline' : ''}`}>
				<span class="text-body-sm font-medium text-ink-secondary">{r.label}</span>
				<span class="text-center">
					{r.us === 'check' && (
						<span class="inline-flex h-6 w-6 items-center justify-center rounded-full" style="background-color: var(--color-status-green-bg)" aria-label="Included">
							<svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
								<path d="M5 12.5l4.5 4.5L19 7.5" stroke="var(--color-status-green-text)" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</span>
					)}
					{r.us === 'none' && <span class="text-body-sm font-semibold text-ink-faint">—</span>}
					{r.hot && (
						<span class="rounded-full px-3 py-1 text-body-sm font-bold text-white" style="background-color: var(--color-primary)">
							{r.us}
						</span>
					)}
				</span>
				<span class="text-center">
					{r.them === 'check' && (
						<span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-canvas-soft" aria-label="Included">
							<svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
								<path d="M5 12.5l4.5 4.5L19 7.5" stroke="var(--color-ink-faint)" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</span>
					)}
					{r.them !== 'check' && <span class="text-caption text-ink-muted">{r.them}</span>}
				</span>
			</div>
		))}
	</div>
	<p class="reveal mx-auto mt-4 max-w-3xl text-center text-caption text-ink-faint">
		Typical paid NEET platforms. We don't do name-and-shame comparisons — the price tag says enough.
	</p>

	<div class="reveal mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
		<a
			href="/signup"
			class="btn-shine inline-flex items-center justify-center gap-2 rounded-full px-8 py-4 text-body-md font-semibold text-white shadow-lift transition-all duration-200 hover:-translate-y-0.5 hover:opacity-95 active:scale-[0.98]"
			style="background-color: var(--color-primary)"
		>
			Get full access — ₹999
			<svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
				<path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
			</svg>
		</a>
		<a
			href="/#how"
			class="inline-flex items-center justify-center rounded-full border border-hairline bg-surface px-8 py-4 text-body-md font-medium text-ink transition-all duration-200 hover:border-ink-faint"
		>
			See how it works
		</a>
	</div>
</section>
