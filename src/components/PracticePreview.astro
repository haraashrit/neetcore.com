---
/**
 * PracticePreview — product mockup of the practice UI (question window).
 * Theme-aware: renders on light sections (e.g. How It Works) and dark bands.
 */
---

<div class="relative mx-auto w-full max-w-3xl">
	<!-- Soft glow behind the mockup -->
	<div
		class="pointer-events-none absolute -inset-6 rounded-[2rem] opacity-50 blur-3xl"
		style="background: linear-gradient(135deg, rgba(98, 174, 240, 0.28), rgba(214, 182, 246, 0.2) 50%, rgba(255, 100, 200, 0.14))"
		aria-hidden="true"
	></div>

	<!-- Floating chip: accuracy (desktop only) -->
	<div
		class="absolute -right-10 -top-6 z-10 hidden items-center gap-2.5 rounded-xl border border-hairline bg-surface px-4 py-3 shadow-lift lg:flex animate-float"
		aria-hidden="true"
	>
		<span class="flex h-9 w-9 items-center justify-center rounded-full" style="background-color: var(--color-status-green-bg)">
			<svg width="16" height="16" viewBox="0 0 24 24" fill="none">
				<path d="M5 12.5l4.5 4.5L19 7.5" stroke="var(--color-status-green-text)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
			</svg>
		</span>
		<span>
			<span class="block text-body-sm font-bold text-ink">87%</span>
			<span class="block text-[11px] text-ink-muted">Session accuracy</span>
		</span>
	</div>

	<!-- Floating chip: streak (desktop only) -->
	<div
		class="absolute -bottom-6 -left-10 z-10 hidden items-center gap-2.5 rounded-xl border border-hairline bg-surface px-4 py-3 shadow-lift lg:flex animate-float-delayed"
		aria-hidden="true"
	>
		<span class="flex h-9 w-9 items-center justify-center rounded-full" style="background-color: var(--color-status-amber-bg)">
			<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-status-amber-text)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
				<path d="M12 2.5c1 4-2.5 5.5-2.5 9a4.5 4.5 0 0 0 9 0c0-1.5-.5-2.5-1.2-3.5-.8 1-1.3 1.5-2.3 1.5.5-2.5-.5-5.5-3-7z" />
				<path d="M12 22a6.5 6.5 0 0 1-6.5-6.5" />
			</svg>
		</span>
		<span>
			<span class="block text-body-sm font-bold text-ink">12 days</span>
			<span class="block text-[11px] text-ink-muted">Practice streak</span>
		</span>
	</div>

	<div class="relative overflow-hidden rounded-2xl border border-hairline bg-surface text-left text-ink shadow-pop">
		<!-- Window chrome -->
		<div class="flex items-center justify-between border-b border-hairline bg-canvas-soft px-4 py-2.5">
			<div class="flex items-center gap-1.5" aria-hidden="true">
				<span class="h-2.5 w-2.5 rounded-full bg-[#ff5f57]"></span>
				<span class="h-2.5 w-2.5 rounded-full bg-[#febc2e]"></span>
				<span class="h-2.5 w-2.5 rounded-full bg-[#28c840]"></span>
			</div>
			<span class="text-eyebrow font-medium text-ink-faint">neetcore.com/practice/phy</span>
			<span class="inline-flex items-center gap-1.5 rounded-full bg-canvas-soft px-2.5 py-1 text-eyebrow font-semibold text-ink-secondary" aria-hidden="true">
				<svg width="12" height="12" viewBox="0 0 24 24" fill="none">
					<circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2" />
					<path d="M12 7v5l3 3" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
				</svg>
				00:41:26
			</span>
		</div>

		<div class="grid sm:grid-cols-[1fr_auto]">
			<!-- Question pane -->
			<div class="p-5 sm:p-6">
				<div class="flex items-center justify-between gap-3">
					<div class="flex items-center gap-2">
						<span class="rounded-full px-2.5 py-1 text-eyebrow font-semibold text-primary" style="background-color: rgba(0, 117, 222, 0.08)">Physics</span>
						<span class="hidden text-eyebrow text-ink-faint sm:inline">Motion in a Straight Line</span>
					</div>
					<span class="text-caption font-medium text-ink-faint">Question 12 of 180</span>
				</div>

				<p class="mt-4 text-body-md font-medium leading-relaxed text-ink">
					A particle moves along a straight line with velocity
					<span class="font-semibold">v = 4t m/s</span>. What is its displacement between
					<span class="font-semibold">t = 0</span> and <span class="font-semibold">t = 2 s</span>?
				</p>

					<div class="mt-4 space-y-2.5 opt-stagger">
					<div class="flex items-center gap-3 rounded-lg border px-4 py-2.5" style="border-color: var(--color-status-green-border); background-color: var(--color-status-green-bg-subtle)">
						<span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full text-eyebrow font-bold text-white" style="background-color: var(--color-status-green-text)">A</span>
						<span class="text-body-sm text-ink">8 m</span>
						<svg class="ml-auto" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
							<path d="M5 12.5l4.5 4.5L19 7.5" stroke="var(--color-status-green-text)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
					</div>
					<div class="flex items-center gap-3 rounded-lg border border-hairline px-4 py-2.5">
						<span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-canvas-soft text-eyebrow font-semibold text-ink-secondary">B</span>
						<span class="text-body-sm text-ink-secondary">16 m</span>
					</div>
					<div class="flex items-center gap-3 rounded-lg border border-hairline px-4 py-2.5">
						<span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-canvas-soft text-eyebrow font-semibold text-ink-secondary">C</span>
						<span class="text-body-sm text-ink-secondary">4 m</span>
					</div>
					<div class="flex items-center gap-3 rounded-lg border border-hairline px-4 py-2.5">
						<span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-canvas-soft text-eyebrow font-semibold text-ink-secondary">D</span>
						<span class="text-body-sm text-ink-secondary">2 m</span>
					</div>
				</div>

				<div class="mt-5 flex items-center justify-between">
					<span class="rounded-md border border-hairline px-3.5 py-2 text-caption font-medium text-ink-muted">Mark for review</span>
					<span class="rounded-full px-5 py-2 text-caption font-semibold text-white" style="background-color: var(--color-primary)">Save &amp; Next →</span>
				</div>
			</div>

			<!-- Question palette -->
			<div class="hidden border-l border-hairline p-4 sm:block">
				<p class="text-eyebrow font-semibold uppercase tracking-wider text-ink-faint">Palette</p>
				<div class="mt-3 grid w-28 grid-cols-5 gap-1.5" aria-hidden="true">
					{[...Array(20)].map((_, i) => (
						<span
							class={`flex h-5 w-5 items-center justify-center rounded text-[9px] font-bold ${
								i === 11
									? 'text-white'
									: i < 11
										? 'text-white'
										: 'text-ink-faint'
							}`}
							style={
								i === 11
									? 'background-color: var(--color-primary)'
									: i < 11
										? 'background-color: var(--color-status-green-bg); color: var(--color-status-green-text)'
										: 'background-color: var(--color-canvas-soft)'
							}
						>
							{i + 1}
						</span>
					))}
				</div>
				<div class="mt-4 space-y-1.5 border-t border-hairline pt-3 text-left">
					<p class="flex items-center gap-1.5 text-[11px] text-ink-muted"><span class="h-2 w-2 rounded-full" style="background-color: var(--color-status-green-bg); outline: 1px solid var(--color-status-green-border)"></span>Answered</p>
					<p class="flex items-center gap-1.5 text-[11px] text-ink-muted"><span class="h-2 w-2 rounded-full" style="background-color: var(--color-primary)"></span>Current</p>
					<p class="flex items-center gap-1.5 text-[11px] text-ink-muted"><span class="h-2 w-2 rounded-full bg-canvas-soft outline outline-1 outline-hairline"></span>Not visited</p>
				</div>
			</div>
		</div>
	</div>
</div>
