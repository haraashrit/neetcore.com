---
import '../styles/global.css';
import 'katex/dist/katex.min.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'NEETCore — Full NEET Prep for Just ₹999',
	description = 'NEETCore is complete NEET preparation for just ₹999. Practice 24/7 with quality-driven questions in Physics, Chemistry, Botany and Zoology.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="NEETCore" />
		<meta property="og:image" content="/neetcore-logo.png" />
		<meta name="theme-color" content="#213183" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<slot />
		<script>
			// Reveal-on-scroll: fade sections in as they enter the viewport
			const els = document.querySelectorAll('.reveal');
			if ('IntersectionObserver' in window) {
				const io = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (entry.isIntersecting) {
								entry.target.classList.add('is-visible');
								io.unobserve(entry.target);
							}
						}
					},
					{ threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
				);
				els.forEach((el) => io.observe(el));
			} else {
				els.forEach((el) => el.classList.add('is-visible'));
			}
		</script>
	</body>
</html>
